{%- doc -%}
  This snippet is used to render a product card.
  It is used in the product block, featured product block, and the product card block.
  The product object is null or when placeholders are rendered.

  @param {object} product - The product object
  @param {object} children - The children of the product card
  @param {object} [block] - The block object
  @param {number} [product_card_gap] - The gap between the product card children (overrides block settings)
{%- enddoc -%}

{% assign block_settings = block.settings %}

{% style %}
  {% if request.visual_preview_mode %}
    product-card[data-product-transition] {
      width: 100%;
      min-width: 250px;
    }
  {% endif %}
{% endstyle %}

{% liquid
  assign has_quick_add = false
  if settings.quick_add and product.available
    assign has_quick_add = true
  endif

  assign has_mobile_quick_add = false
  if has_quick_add and settings.mobile_quick_add
    assign has_mobile_quick_add = true
  endif

  assign product_card_id = 'product-card-link-' | append: block.id | append: '-' | append: product.id
  assign product_card_gap_value = product_card_gap | default: block_settings.product_card_gap

  # Logic to determine which variant URL to use (matching swatch selection logic)
  assign variant_to_link = product.selected_or_first_available_variant

  if settings.transition_to_main_product
    assign featured_image = variant_to_link.featured_image
    if featured_image == blank
      assign featured_image = product.featured_media.preview_image
    endif

    if featured_image != blank
      assign featured_media_url = featured_image | image_url: width: 500
    endif
  endif

  assign onboarding = false
  if product.id == empty or product == blank
    assign onboarding = true
  endif
%}

<product-card
  class="product-card size-style"
  style="{% render 'size-style', settings: block_settings %}"
  data-product-id="{{ product.id }}"
  id="product-card-{{ block.id }}"
  {% if settings.transition_to_main_product %}
    data-product-transition="true"
    data-featured-media-url="{{ featured_media_url }}"
    on:click="/handleViewTransition"
  {% endif %}
  {{ block.shopify_attributes }}
  {% if onboarding %}
    data-placeholder="true"
  {% endif %}
>
  <a
    id="{{ product_card_id | md5 }}"
    {% unless onboarding %}
      href="{{ variant_to_link.url }}"
    {% endunless %}
    class="product-card__link"
    ref="productCardLink"
  >
    <span class="visually-hidden">
      {{ product.title }}
    </span>
  </a>
  <div
    class="
      product-card__content
      layout-panel-flex
      layout-panel-flex--column
      product-grid__card
      spacing-style
      border-style
      gap-style
      {% if block_settings.inherit_color_scheme == false %} color-{{ block_settings.color_scheme }}{% endif %}
    "
    style="
      {% render 'border-override', settings: block_settings %}
      {% render 'layout-panel-style', settings: block_settings %}
      {% render 'spacing-style', settings: block_settings %}
      {% render 'gap-style', value: product_card_gap_value, name: 'product-card-gap' %}
      --quick-add-display: {% if has_quick_add %}flex{% else %}none{% endif %};
      --quick-add-mobile-display: {% if has_mobile_quick_add %}flex{% else %}none{% endif %};
      --quick-add-mobile-opacity: {% if has_mobile_quick_add %}1{% else %}0{% endif %};
      {% if block_settings.padding-inline-start > 0 %}--zoom-out-padding-inline-start: min(var(--padding-xs), {{ block_settings.padding-inline-start | times: 0.7}}px);{% endif %}
      {% if block_settings.padding-inline-end > 0 %}--zoom-out-padding-inline-end: min(var(--padding-xs), {{ block_settings.padding-inline-end | times: 0.7}}px);{% endif %}
      {% if block_settings.padding-block-start > 0 %}--zoom-out-padding-block-start: min(var(--padding-xs), {{ block_settings.padding-block-start | times: 0.7}}px);{% endif %}
      {% if block_settings.padding-block-end > 0 %}--zoom-out-padding-block-end: min(var(--padding-xs), {{ block_settings.padding-block-end | times: 0.7}}px);{% endif %}
    "
  >
    {{ children }}

    {%- if product.selling_plan_groups != blank and onboarding == false -%}
      {%- liquid
        assign target_numbers = '2,3,4,6' | split: ','
        assign plan_pairs = ''
        assign used_ids = '|'
        for n in target_numbers
          assign found_plan_id = ''
          assign pattern_a = ' ' | append: n | append: ' week'
          assign pattern_b = n | append: '-week'
          for group in product.selling_plan_groups
            for plan in group.selling_plans
              if found_plan_id == ''
                assign id_marker = '|' | append: plan.id | append: '|'
                unless used_ids contains id_marker
                  assign haystack = ' ' | append: plan.name
                  for opt in plan.options
                    assign haystack = haystack | append: ' ' | append: opt.value
                  endfor
                  assign haystack = haystack | downcase
                  if haystack contains pattern_a or haystack contains pattern_b
                    assign found_plan_id = plan.id | append: ''
                  endif
                endunless
              endif
            endfor
          endfor
          if found_plan_id != ''
            assign used_ids = used_ids | append: found_plan_id | append: '|'
            if plan_pairs != ''
              assign plan_pairs = plan_pairs | append: ';'
            endif
            assign plan_pairs = plan_pairs | append: found_plan_id | append: ',' | append: n | append: ' weeks'
          endif
        endfor
        assign plan_pair_list = plan_pairs | split: ';'
        assign first_pair_parts = plan_pair_list.first | split: ','
        assign default_plan_id = first_pair_parts.first
        assign initial_variant = product.selected_or_first_available_variant
      -%}
      {%- if plan_pairs != '' -%}
      <div
        class="product-card__subscription"
        data-subscription-toggle
        data-product-id="{{ product.id }}"
        data-variant-id="{{ initial_variant.id }}"
        data-default-plan="{{ default_plan_id }}"
        data-variant-available="{% if initial_variant.available %}true{% else %}false{% endif %}"
      >
        {%- if product.variants.size > 1 -%}
          <select
            class="product-card__variant-select"
            data-variant-select
            aria-label="Variant"
          >
            {%- for variant in product.variants -%}
              <option
                value="{{ variant.id }}"
                data-available="{% if variant.available %}true{% else %}false{% endif %}"
                {% if variant.id == initial_variant.id %}selected{% endif %}
              >
                {{ variant.title | escape }}{% unless variant.available %} - Sold Out{% endunless %}
              </option>
            {%- endfor -%}
          </select>
        {%- endif -%}

        <div class="product-card__sub-options" role="radiogroup" aria-label="Purchase type">
          <button
            type="button"
            class="product-card__sub-option"
            data-sub-option="onetime"
            role="radio"
            aria-checked="true"
            data-active="true"
          >
            One-time
          </button>
          <button
            type="button"
            class="product-card__sub-option"
            data-sub-option="subscribe"
            role="radio"
            aria-checked="false"
          >
            Subscribe
          </button>
        </div>

        <select
          class="product-card__sub-frequency"
          data-sub-frequency
          aria-label="Subscription frequency"
          hidden
        >
          {%- for pair in plan_pair_list -%}
            {%- assign parts = pair | split: ',' -%}
            {%- if parts.size == 2 -%}
              <option value="{{ parts[0] }}">{{ parts[1] }}</option>
            {%- endif -%}
          {%- endfor -%}
        </select>

        <button
          type="button"
          class="product-card__sub-add"
          data-sub-add-to-cart
          {% unless initial_variant.available %}disabled{% endunless %}
        >
          <span data-sub-add-label>
            {%- if initial_variant.available -%}
              Add to Cart
            {%- else -%}
              {{ 'products.product.sold_out' | t | default: 'Sold Out' }}
            {%- endif -%}
          </span>
        </button>

        <p
          class="product-card__sub-error"
          data-sub-error
          role="status"
          aria-live="polite"
          hidden
        ></p>
      </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</product-card>

{% stylesheet %}
  .product-card__placeholder-image svg {
    height: 100%;
  }

  @media screen and (max-width: 749px) {
    .product-card slideshow-arrows .slideshow-control {
      display: none;
    }
  }

  .product-card__subscription {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-block-start: 0.4rem;
    font-family: var(--font-body--family);
  }

  .product-card__sub-options {
    display: inline-flex;
    width: 100%;
    background-color: #ece7d9;
    border-radius: 999px;
    padding: 3px;
    box-sizing: border-box;
  }

  .product-card__sub-option {
    flex: 1;
    border: 0;
    background: transparent;
    color: #1a2340;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    padding: 0.45rem 0.6rem;
    border-radius: 999px;
    cursor: pointer;
    transition: background-color 200ms ease, color 200ms ease;
  }

  .product-card__sub-option[data-active="true"] {
    background-color: #9a7c3f;
    color: #f5f0e8;
  }

  .product-card__variant-select,
  .product-card__sub-frequency {
    width: 100%;
    box-sizing: border-box;
    font-family: var(--font-body--family);
    font-size: 0.8rem;
    color: #1a2340;
    background-color: #f5f0e8;
    border: 1px solid #c7bfaa;
    border-radius: 6px;
    padding: 0.4rem 0.6rem;
  }

  .product-card__sub-frequency[hidden] {
    display: none;
  }

  /* When our subscription widget renders, hide the theme's buy-buttons block
     for this card so the dedicated subscription-aware button is the only ATC. */
  .product-card__content:has(.product-card__subscription) .buy-buttons-block {
    display: none;
  }

  .product-card__sub-add {
    width: 100%;
    box-sizing: border-box;
    margin-block-start: 0.35rem;
    padding-block: 0.7rem;
    padding-inline: 1rem;
    border: 0;
    border-radius: 999px;
    background-color: #1a2340;
    color: #f5f0e8;
    font-family: var(--font-body--family);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 200ms ease, opacity 200ms ease;
  }

  .product-card__sub-add:hover:not(:disabled) {
    background-color: #9a7c3f;
  }

  .product-card__sub-add:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .product-card__sub-add[data-loading="true"] {
    opacity: 0.7;
    cursor: progress;
  }

  .product-card__sub-error {
    margin: 0;
    font-size: 0.75rem;
    color: #b00020;
  }

  .product-card__sub-error[hidden] {
    display: none;
  }
{% endstylesheet %}

<script>
  (function () {
    if (window.__pcSubInit) return;
    window.__pcSubInit = true;

    var DEFAULT_ADD_LABEL = 'Add to Cart';
    var SUBSCRIBE_ADD_LABEL = 'Subscribe & Add';
    var ADDED_LABEL = 'Added!';
    var ADDED_RESET_MS = 1600;

    function cartAddUrl() {
      try {
        if (window.Theme && Theme.routes && Theme.routes.cart_add_url) {
          // Force JSON response; the .js suffix is safe to append.
          var u = Theme.routes.cart_add_url;
          return /\.js(\?|$)/.test(u) ? u : u + '.js';
        }
      } catch (e) {}
      return '/cart/add.js';
    }

    function getCartSectionIds() {
      var ids = [];
      document.querySelectorAll('cart-items-component[data-section-id]').forEach(function (el) {
        var id = el.getAttribute('data-section-id');
        if (id && ids.indexOf(id) === -1) ids.push(id);
      });
      return ids.join(',');
    }

    function applyMode(toggle, mode) {
      toggle.setAttribute('data-mode', mode);

      toggle.querySelectorAll('[data-sub-option]').forEach(function (opt) {
        var isActive = opt.getAttribute('data-sub-option') === mode;
        opt.setAttribute('data-active', isActive ? 'true' : 'false');
        opt.setAttribute('aria-checked', isActive ? 'true' : 'false');
      });

      var freq = toggle.querySelector('[data-sub-frequency]');
      if (freq) {
        if (mode === 'subscribe') {
          freq.hidden = false;
          if (!freq.value) freq.value = toggle.getAttribute('data-default-plan') || '';
        } else {
          freq.hidden = true;
        }
      }

      var label = toggle.querySelector('[data-sub-add-label]');
      var btn = toggle.querySelector('[data-sub-add-to-cart]');
      if (label && btn && btn.getAttribute('data-loading') !== 'true') {
        var available = toggle.getAttribute('data-variant-available') !== 'false';
        if (!available) {
          label.textContent = 'Sold Out';
        } else {
          label.textContent = mode === 'subscribe' ? SUBSCRIBE_ADD_LABEL : DEFAULT_ADD_LABEL;
        }
      }
    }

    function showError(toggle, message) {
      var err = toggle.querySelector('[data-sub-error]');
      if (!err) return;
      err.textContent = message || 'Something went wrong. Please try again.';
      err.hidden = false;
      setTimeout(function () {
        if (err) err.hidden = true;
      }, 4000);
    }

    function dispatchCartUpdate(toggle, cart, sections, variantId) {
      var detail = {
        resource: cart,
        sourceId: 'product-card-subscription:' + (toggle.getAttribute('data-product-id') || ''),
        data: {
          source: 'product-card-subscription',
          productId: toggle.getAttribute('data-product-id') || undefined,
          variantId: variantId,
          itemCount: 1,
          sections: sections || undefined,
        },
      };
      document.dispatchEvent(new CustomEvent('cart:update', { bubbles: true, detail: detail }));
    }

    function addToCart(toggle) {
      var btn = toggle.querySelector('[data-sub-add-to-cart]');
      if (!btn || btn.getAttribute('data-loading') === 'true' || btn.disabled) return;

      var variantId = toggle.getAttribute('data-variant-id');
      if (!variantId) {
        showError(toggle, 'No variant available.');
        return;
      }

      var mode = toggle.getAttribute('data-mode') || 'onetime';
      var freq = toggle.querySelector('[data-sub-frequency]');
      var planId = mode === 'subscribe' && freq ? freq.value : '';

      var label = toggle.querySelector('[data-sub-add-label]');
      var originalText = label ? label.textContent : '';
      btn.setAttribute('data-loading', 'true');
      btn.disabled = true;
      if (label) label.textContent = 'Adding…';

      var fd = new FormData();
      fd.append('id', variantId);
      fd.append('quantity', '1');
      if (planId) fd.append('selling_plan', planId);
      var sectionIds = getCartSectionIds();
      if (sectionIds) fd.append('sections', sectionIds);

      fetch(cartAddUrl(), {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: fd,
      })
        .then(function (res) {
          return res.json().then(function (body) { return { ok: res.ok, body: body }; });
        })
        .then(function (result) {
          if (!result.ok || (result.body && result.body.status)) {
            var msg = (result.body && (result.body.description || result.body.message)) || 'Could not add to cart.';
            showError(toggle, msg);
            return;
          }

          var sections = result.body && result.body.sections;

          // Fetch the latest cart and broadcast so the cart drawer and the
          // progress bar pick it up.
          return fetch('/cart.js', { credentials: 'same-origin' })
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (cart) {
              dispatchCartUpdate(toggle, cart, sections, variantId);
              if (label) label.textContent = ADDED_LABEL;
              setTimeout(function () {
                if (label && btn.getAttribute('data-loading') !== 'true') {
                  // Restore based on current mode.
                  applyMode(toggle, toggle.getAttribute('data-mode') || 'onetime');
                }
              }, ADDED_RESET_MS);
            });
        })
        .catch(function () {
          showError(toggle, 'Network error. Please try again.');
          if (label) label.textContent = originalText;
        })
        .finally(function () {
          btn.removeAttribute('data-loading');
          if (toggle.getAttribute('data-variant-available') !== 'false') {
            btn.disabled = false;
          }
        });
    }

    function init(toggle) {
      if (toggle.__pcSubBound) return;
      toggle.__pcSubBound = true;

      toggle.querySelectorAll('[data-sub-option]').forEach(function (opt) {
        opt.addEventListener('click', function () {
          applyMode(toggle, opt.getAttribute('data-sub-option'));
        });
      });

      var btn = toggle.querySelector('[data-sub-add-to-cart]');
      if (btn) {
        btn.addEventListener('click', function () { addToCart(toggle); });
      }

      var variantSelect = toggle.querySelector('[data-variant-select]');
      if (variantSelect) {
        variantSelect.addEventListener('change', function () {
          var opt = variantSelect.options[variantSelect.selectedIndex];
          if (!opt) return;
          toggle.setAttribute('data-variant-id', opt.value);
          var available = opt.getAttribute('data-available') !== 'false';
          toggle.setAttribute('data-variant-available', available ? 'true' : 'false');
          if (btn) btn.disabled = !available;
          applyMode(toggle, toggle.getAttribute('data-mode') || 'onetime');
        });
      }

      // If the theme dispatches variant:update for swatch changes within this
      // card, sync our hidden variant ID and availability state.
      var card = toggle.closest('product-card');
      if (card) {
        card.addEventListener('variant:update', function (event) {
          var resource = event && event.detail && event.detail.resource;
          if (!resource) return;
          if (resource.id) toggle.setAttribute('data-variant-id', String(resource.id));
          toggle.setAttribute('data-variant-available', resource.available === false ? 'false' : 'true');
          if (btn) btn.disabled = resource.available === false;
          applyMode(toggle, toggle.getAttribute('data-mode') || 'onetime');
        });
      }

      // Default state: one-time.
      applyMode(toggle, 'onetime');
    }

    function initAll(scope) {
      (scope || document).querySelectorAll('[data-subscription-toggle]').forEach(init);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () { initAll(); });
    } else {
      initAll();
    }

    // Re-init when product cards are added (infinite scroll / filter updates).
    var observer = new MutationObserver(function (mutations) {
      mutations.forEach(function (m) {
        m.addedNodes.forEach(function (node) {
          if (node.nodeType !== 1) return;
          if (node.matches && node.matches('[data-subscription-toggle]')) {
            init(node);
          } else if (node.querySelectorAll) {
            initAll(node);
          }
        });
      });
    });
    observer.observe(document.body, { childList: true, subtree: true });
  })();
</script>
